# Required — get a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — persistent data directory (default: current working directory)
# On Render: set to /data and mount a persistent disk at /data
DATA_DIR=/data

# Optional — controls the edition seal on cards (defaults to 2025-06-26)
LAUNCH_DATE=2025-06-26
