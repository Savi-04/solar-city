# ─── Required ────────────────────────────────────────────────────────────────

# Gemini, used for the photo safety check. https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# fal.ai, used for portrait stylisation (nano-banana-2) and video (kling).
# https://fal.ai/dashboard/keys
FAL_KEY=your_fal_key_here

# Unlocks the payment bypass (/?admin_mode=<value>), /analytics and the admin
# panel. Without it those endpoints refuse every request. Use a long random
# value: it is the only thing standing between the internet and free generation.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_SECRET=generate_a_long_random_value

# ─── Payments (not needed for local admin-bypass testing) ────────────────────

# Gumroad product URL the Pay button redirects to.
# Build-time var: it must be present when `npm run build` runs, not just at runtime.
VITE_GUMROAD_PRODUCT_URL=https://yourname.gumroad.com/l/yourproduct

# Verifies incoming Gumroad webhooks really came from your account.
GUMROAD_SELLER_ID=your_gumroad_seller_id

# ─── Optional ────────────────────────────────────────────────────────────────

# Persistent data directory. jobs.db and videos/ are written here.
# Leave unset locally (defaults to the project directory, already gitignored).
# In production point this at a mounted volume, e.g. /data on Railway.
# DATA_DIR=/data

# Public origin, used to build absolute URLs in emails and OG tags.
# BASE_URL=https://your-domain.com

# Card delivery email. If either is unset, sendCardEmail logs a warning and
# skips silently, so buyers get no email at all.
# SMTP_USER=you@example.com
# SMTP_PASS=your_app_password

# Controls the edition seal on cards.
# LAUNCH_DATE=2025-06-26
